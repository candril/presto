{
  "name": "presto",
  "version": "0.3.0",
  "description": "Terminal-based pull request discovery and management tool",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "bin": {
    "presto": "./dist/presto"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "0.5.12",
    "@opentui/react": "0.5.12",
    "react": "19.3.0",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/candril/presto.git"
  },
  "homepage": "https://candril.github.io/presto/"
}
